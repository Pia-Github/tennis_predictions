def test_data_encoding_maps_round_and_leaves_only_numbers():
    # Given: a small dataset with all categorical columns
    df = pd.DataFrame({
        "tourney_id": ["t1", "t2"], "tourney_name": ["A", "B"],
        "name_1": ["X", "Y"], "name_2": ["Y", "X"],
        "ioc_1": ["GER", "USA"], "ioc_2": ["USA", "GER"],
        "tourney_level": ["G", "M"], "surface": ["Hard", "Clay"],
        "hand_1": ["R", "L"], "hand_2": ["L", "R"],
        "round": ["QF", "F"],
    })
 
    # When
    result = preprocessing.data_encoding(df)
 
    # Then: round follows the match progression (QF -> 5, F -> 7)
    assert result["round"].tolist() == [5, 7]
    # and every column is numeric (no text left for the model)
    assert all(pd.api.types.is_numeric_dtype(result[c]) for c in result.columns)
    # and one-hot columns exist, e.g. for surface
    assert {"surface_Hard", "surface_Clay"}.issubset(result.columns)
 
 
