def test_missing_data_handling_fills_missing_rank():
    # Given: a player without rank and rank points
    df = pd.DataFrame({
        "minutes": [100, 120, 90],
        "rank_1": [np.nan, 5.0, 7.0], "rank_2": [3.0, np.nan, 8.0],
        "rank_points_1": [np.nan, 10.0, 20.0], "rank_points_2": [30.0, np.nan, 40.0],
        "age_1": [25.0, 30.0, 28.0], "ht_1": [185.0, 190.0, 180.0],
        "age_2": [27.0, 22.0, 33.0], "ht_2": [188.0, 175.0, 182.0],
    })
 
    # When
    result = preprocessing.missing_data_handling(df)
 
    # Then: missing rank -> 9999, missing rank points -> 0
    assert result["rank_1"].tolist() == [9999, 5, 7]
    assert result["rank_2"].tolist() == [3, 9999, 8]
    assert result["rank_points_1"].tolist() == [0, 10, 20]
    assert result["rank_points_2"].tolist() == [30, 0, 40]
 
 
