BASE_DIR = os.path.dirname(os.path.abspath(__file__))
CSV_PATH = os.path.join(BASE_DIR, "..", "src", "tennis_pred_1", "ATP_tennis_group_project.csv")
 
 
def load_tennis_df():
    """Loads the real raw dataset."""
    return pd.read_csv(CSV_PATH, low_memory=False)
 
 
def make_player_columns(n):
    """Creates n small matches with winner_* / loser_* columns.
 
    Winner values and loser values are clearly distinguishable
    (winner age = 20, loser age = 30, etc.), so we can see later
    which player ended up in which column.
    """
    return pd.DataFrame({
        "winner_name": [f"W{i}" for i in range(n)],
        "winner_hand": "R",
        "winner_ht": 180.0,
        "winner_ioc": "GER",
        "winner_age": 20.0,
        "winner_rank": 1.0,
        "winner_rank_points": 1000.0,
        "loser_name": [f"L{i}" for i in range(n)],
        "loser_hand": "L",
        "loser_ht": 190.0,
        "loser_ioc": "USA",
        "loser_age": 30.0,
        "loser_rank": 2.0,
        "loser_rank_points": 500.0,
    })
 
 
@pytest.fixture(scope="module")
def preprocessed_df():
    """Runs the full preprocessing once on the real data and shares the result between tests."""
    return preprocessing.preprocessing(load_tennis_df())


