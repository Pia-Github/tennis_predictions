def test_date_to_month_converts_correctly():
    # Given: one match in January and one in July
    df = pd.DataFrame({"tourney_date": ["2024-01-15", "2024-07-01"]})
 
    # When
    result = preprocessing.date_to_month(df)
 
    # Then: January -> sin(2*pi*1/12) = 0.5, cos = 0.866
    #       July    -> sin(2*pi*7/12) = -0.5, cos = -0.866
    assert result["tourney_month_sin"].tolist() == pytest.approx([0.5, -0.5])
    assert result["tourney_month_cos"].tolist() == pytest.approx([np.sqrt(3) / 2, -np.sqrt(3) / 2])
    # and the original and intermediate columns are gone
    assert "tourney_date" not in result.columns
    assert "month" not in result.columns
 
def test_blinding_keeps_both_players_in_each_match():
    # Given: 100 matches with clearly different winner and loser values
    df = make_player_columns(100)
    winners = df["winner_name"].copy()
    losers = df["loser_name"].copy()
 
    # When
    result = preprocessing.blinding_winning_losing(df)
 
    # Then: in every match, player 1 and 2 are exactly the winner and the loser
    for i in range(len(result)):
        assert {result["name_1"][i], result["name_2"][i]} == {winners[i], losers[i]}
 
 
def test_blinding_keeps_player_attributes_together():
    # Given: winners are always 20 years old, losers always 30
    df = make_player_columns(100)
 
    # When
    result = preprocessing.blinding_winning_losing(df)
 
    # Then: whoever is player 1, the age belongs to the same person as the name
    is_winner_1 = result["name_1"].str.startswith("W")
    assert (result.loc[is_winner_1, "age_1"] == 20).all()
    assert (result.loc[~is_winner_1, "age_1"] == 30).all()
    # and the original winner_/loser_ columns are gone
    assert not any(c.startswith(("winner_", "loser_")) for c in result.columns)
 
 
def test_blinding_splits_winners_about_half_half():
    # Given: many matches
    df = make_player_columns(2000)
 
    # When
    result = preprocessing.blinding_winning_losing(df)
 
    # Then: the winner is player 1 in roughly 50 % of the matches (random, so with tolerance)
    share_winner_1 = result["name_1"].str.startswith("W").mean()
    assert 0.45 < share_winner_1 < 0.55
 
